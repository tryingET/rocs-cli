# Optional cron fallback (use this OR the systemd timer, not both):
# Run the FCOS fleet audit nightly, persist scorecards under XDG state, and
# emit remediation batches when drift is detected.
17 2 * * * FCOS_WORKSPACE_ROOT=/home/tryinget/ai-society FCOS_REMEDIATION_MODE=patch /usr/bin/env bash -lc 'cd /home/tryinget/ai-society/core/rocs-cli && ./scripts/run-fleet-audit-nightly.sh' >> /home/tryinget/.local/state/fcos/nightly/cron.log 2>&1

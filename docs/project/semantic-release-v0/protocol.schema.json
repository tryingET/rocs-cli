        "recorded_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "issuer": { "$ref": "#/$defs/issuer" },
        "audit_sequence": { "$ref": "#/$defs/safeInteger" },

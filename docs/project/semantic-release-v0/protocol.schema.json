        "ak_evidence_linkage_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "rollbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issuer", "axis", "active_activation_receipt_digest", "from_coordinate", "from_runtime_identity", "target", "target_materialization_receipt_digest", "recovery_runtime_identity", "owner_decision", "precondition_digest", "rollback_request_digest"],
      "properties": {
        "schema": { "const": "semantic-rollback-request.v0" },
        "issuer": { "$ref": "#/$defs/issuer" },
        "axis": { "enum": ["semantic", "runtime", "combined", "no_prior_disable"] },
        "active_activation_receipt_digest": { "$ref": "#/$defs/digest" },
        "from_coordinate": { "$ref": "#/$defs/coordinate" },
        "from_runtime_identity": { "$ref": "#/$defs/toolIdentity" },
        "target": { "$ref": "#/$defs/rollbackTarget" },

          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "recovery_runtime_identity": { "$ref": "#/$defs/toolIdentity" },
        "owner_decision": { "$ref": "#/$defs/decisionReference" },
        "precondition_digest": { "$ref": "#/$defs/digest" },
        "rollback_request_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "rollbackReceipt": {
      "type": "object",
      "additionalProperties": false,

            { "$ref": "#/$defs/digest" }
          ]
        },
        "audit_envelope_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "maxLength": 4096 }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "code", "stage", "retryable", "related_artifact_digest", "details", "error_digest"],
      "properties": {
        "schema": { "const": "semantic-protocol-error.v0" },
        "code": { "enum": ["malformed_input", "unsupported_protocol", "resource_exhausted", "deadline_exceeded", "network_forbidden", "trust_root_missing", "trust_reference_stale", "trust_revoked", "owner_approval_missing", "self_certification", "publication_conflict", "version_conflict", "snapshot_drift", "incomplete_tree", "compatibility_unknown", "compatibility_rejected", "atomic_activation_unavailable", "recovery_needed", "rollback_unavailable", "history_conflict", "issuer_scope_violation"] },
        "stage": { "enum": ["decode", "validate", "build", "approve", "publish", "materialize", "activate", "generate", "deliver", "link", "rollback", "recover"] },
        "retryable": { "type": "boolean" },
        "related_artifact_digest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "details": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/errorDetail" } },
        "error_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
